# PostgreSQL (en Vercel use la URL pooled de Neon / Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/supervision_aps?schema=public"

# Conexión directa (migraciones). En Neon es la URL sin pgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/supervision_aps?schema=public"

# JWT de sesión (cookie web + Bearer móvil). Obligatorio en Vercel.
JWT_SECRET="cambiar-en-produccion-minimo-32-caracteres"

# Origenes con cookie (web). Separados por coma. En Vercel: https://tu-app.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Solo desarrollo: extra hosts para Next (LAN). No hace falta en Vercel.
# ALLOWED_DEV_ORIGINS="http://192.168.0.10:3000"

# Seed local (no se usa en el build de Vercel)
SEED_ADMIN_EMAIL="admin@supervision.local"
SEED_ADMIN_PASSWORD="admin12@"

# App Expo: URL pública de la API (la de Vercel cuando esté desplegada)
# EXPO_PUBLIC_API_URL="https://tu-app.vercel.app"
